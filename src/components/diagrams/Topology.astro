ass="t-b" text-anchor="middle">Fly proxy (TLS, certs)</text><polyline points="410,96 410,128" class="edge-accent" marker-end="url(#topo-ac)"/><polyline points="550,96 550,128" class="edge-accent" marker-end="url(#topo-ac)"/><rect x="350" y="130" width="120" height="56" rx="8" class="box-accent"/><text x="410" y="154" class="t-b" text-anchor="middle">Gateway</text><text x="410" y="172" class="t-muted" text-anchor="middle">:8080</text><rect x="490" y="130" width="120" height="56" rx="8" class="box"/><text x="550" y="154" class="t-b" text-anchor="middle">Admin</text><text x="550" y="172" class="t-muted" text-anchor="middle">:8080</text><polyline points="490,158 470,158" class="edge" marker-end="url(#topo-a)"/><rect x="350" y="250" width="120" height="76" rx="8" class="box-hot"/><text x="410" y="284" class="t-b" text-anchor="middle">PostgreSQL</text><text x="410" y="302" class="t-muted" text-anchor="middle">your choice</text><rect x="490" y="250" width="120" height="76" rx="8" class="box-cold"/><text x="550" y="284" class="t-b" text-anchor="middle">Bucket</text><text x="550" y="302" class="t-muted" text-anchor="middle">Tigris or any S3</text><polyline points="390,186 390,250" class="edge" marker-end="url(#topo-a)"/><polyline points="550,186 430,250" class="edge-dash" marker-end="url(#topo-a)"/><polyline points="440,186 530,250" class="edge" marker-end="url(#topo-a)"/><text x="480" y="356" class="t-muted" text-anchor="middle">fly deploy --image ...</text><text x="480" y="376" class="t-muted" text-anchor="middle">fly ssh console for one-offs</text><rect x="650" y="10" width="300" height="400" rx="12" class="zone"/><text x="800" y="36" class="t-b" text-anchor="middle">Portainer</text><rect x="670" y="52" width="260" height="44" rx="8" class="box"/><text x="800" y="79" class="t-b" text-anchor="middle">Reverse proxy (TLS)</text><polyline points="730,96 730,128" class="edge-accent" marker-end="url(#topo-ac)"/><polyline points="870,96 870,128" class="edge-accent" marker-end="u